# Veritabanı (Supabase / Neon / local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/personal_site"

# Auth.js secret — üret: openssl rand -base64 32
AUTH_SECRET="your-super-secret-here"

# Seed sırasında oluşturulacak admin parolası (en az 12 karakter)
ADMIN_PASSWORD="use-a-strong-password-here"

# Supabase Storage (secret key yalnızca sunucuda kullanılmalıdır)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-server-only-key"
SUPABASE_STORAGE_BUCKET="blog-images"

# Uygulama URL
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare Turnstile (site key istemcide, secret key yalnızca sunucuda)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
